# Токен бота от @BotFather. Только в переменных окружения (Railway → Variables), не в коде и не в git
BOT_TOKEN=123456:ABC...
# 1 (по умолчанию) — демо: ученик сам получает карточку администратора. 0 — заявки уходят в ADMIN_CHAT_ID
DEMO_MODE=1
# Необязательно: чат администратора (узнать — написать боту /id). Ему доступна /stats
ADMIN_CHAT_ID=
# Сайт, откуда бот берёт персональные демо центров (/api/p/<slug>). По умолчанию https://edu.caravanhouse.uz
SCHOOLS_API=
# Бот заявок CaravanHouse IT для кнопки «Хочу такого бота». По умолчанию https://t.me/CaravanHousebot
LEAD_BOT_URL=
# Папка для данных. На Railway подключите Volume и укажите его путь, например /data. По умолчанию ./data
DATA_DIR=
